# Copie este arquivo para .env e preencha com os valores do seu projeto Supabase.
# Painel Supabase > Project Settings > API
#
# ATENÇÃO:
# - VITE_SUPABASE_URL é a URL RAIZ do projeto (SEM /rest/v1/ no final)
# - VITE_SUPABASE_ANON_KEY é a chave "anon / publishable" (começa com sb_publishable_ ou eyJ...)
# - NUNCA use a secret key (sb_secret_...) no frontend!

VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
